# Public URL of the deployed app (used for WhatsApp deep links and OG metadata)
APP_URL=http://localhost:5173

# Google Gemini API key for AI-assisted jacket configuration
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Disable Vite HMR when running in constrained environments (Docker, CI)
# Set to "true" to disable hot reload; leave empty or "false" for normal dev
DISABLE_HMR=false
